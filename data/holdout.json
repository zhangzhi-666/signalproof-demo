      "id": "HC01",
      "category": "卷积",
      "title": "混合输入与负时移",
      "steps": [
        "Conv(3*x(t)-h(t),delta(t+2),t)",
        "3*x(t+2)-h(t+2)"
      ],
      "context": {},
      "expected": "correct",
      "expectedFirstError": null,
      "expectedLocalStatuses": [
        "correct"
      ],
      "rationale": "线性分配后两项都超前 2，保留各自系数。"
    },
    {
      "id": "HC02",
      "category": "卷积",
      "title": "两侧常数一起提出",
      "steps": [
        "Conv(-2*x(t),3*h(t),t)",
